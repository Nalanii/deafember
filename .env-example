DISCORD_WEBHOOK_URL = "https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN"

# FACEBOOK & INSTAGRAM (Meta for Developers)
# You need a "User Access Token" with scopes: 
# pages_manage_posts, pages_read_engagement, publish_to_groups
META_USER_ACCESS_TOKEN = "YOUR_LONG_LIVED_USER_ACCESS_TOKEN"

FB_DEAFEMBER_PAGE_ID = "DEAFEMBER_FACEBOOK_PAGE_ID"
FB_SOF_PAGE_ID = "SIGN_OF_FUN_FACEBOOK_PAGE_ID"

IG_USER_ID = "YOUR_INSTAGRAM_BUSINESS_ACCOUNT_ID" 

# TWITTER / X (Twitter Developer Portal)
# You need OAuth 1.0a User Context keys (Read and Write permissions)
TWITTER_API_KEY = "YOUR_API_KEY"
TWITTER_API_SECRET = "YOUR_API_KEY_SECRET"
TWITTER_ACCESS_TOKEN = "YOUR_ACCESS_TOKEN"
TWITTER_ACCESS_SECRET = "YOUR_ACCESS_TOKEN_SECRET"